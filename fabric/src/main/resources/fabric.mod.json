{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": ["${mod_author}"],
    "contributors": ["${credits}"],
    "contact": {
        "homepage": "https://fabricmc.net/",
        "sources": "https://github.com/FabricMC/fabric-example-mod"
    },
    "license": "${license}",
    "icon": "logo.png",
    "environment": "*",
    "entrypoints": {
        "main": ["ru.magistu.siegemachines.fabric.SiegeMachinesFabric"],
        "client": ["ru.magistu.siegemachines.client.fabric.ClientProxyFabric"],
        "rei_client": ["ru.magistu.siegemachines.plugin.rei.ReiClientPlugin"],
        "jei_mod_plugin": ["ru.magistu.siegemachines.plugin.jei.JeiPlugin"]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.16.5",
        "minecraft": "~1.21.1",
        "fabric-api": "*",
        "architectury": ">=13.0.0",
        "geckolib": ">=4.0.0",
        "forgeconfigapiport": ">=21.1.1",
        "java": ">=21"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  